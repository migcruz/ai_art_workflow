# Local environment overrides
.env

# Ignore data contents but keep directory structure via .gitkeep files
# The !data/**/ line is required — git won't traverse into ignored directories
# without explicitly un-ignoring them first.
# custom_nodes/ subdirs are re-ignored because they are cloned at runtime.
data/**
!data/**/
!data/**/.gitkeep
data/custom_nodes/*/

# Python
__pycache__/
*.pyc
*.pyo
